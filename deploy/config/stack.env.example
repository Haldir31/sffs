# Paramètres généraux de la pile (lus par tous les scripts de deploy/bin).
# Copier en $SFFS_STACK/config/stack.env (défaut SFFS_STACK=$HOME/sffs-stack).

# Nom du pod podman et des conteneurs (préfixe).
POD=silo-sffs

# Image Silo construite par build-silo.sh.
SILO_IMAGE=localhost/silo-sffs:latest

# Ports publiés sur 127.0.0.1 (mettre un reverse proxy HTTPS devant).
SILO_WEB_PORT=27461   # interface web + API Silo
SILO_JF_PORT=21481    # API compatible Jellyfin (Infuse, Swiftfin, apps TV…)
SILO_ABS_PORT=21482   # API compatible Audiobookshelf

# 1 = ajoute 10.10.10.10/32 sur l'interface lo du pod. Nécessaire si l'hôte n'a AUCUNE
# adresse IPv4 privée (ex. seedbox mutualisée) : le générateur d'identifiants de Silo
# (sonyflake) plante sans adresse privée. 0 sur un serveur classique (LAN, VPS avec IP privée).
ADD_DUMMY_PRIVATE_IP=0

# 1 = la base de StreamFusion tourne dans un pod podman de CE serveur, non publié :
# start.sh lance alors sf-db-bridge.sh (socket Unix -> Postgres du pod). 0 = SF_PG_DSN de
# sffs.env pointe directement vers un Postgres joignable.
SF_DB_BRIDGE=0
SF_POD=stream-fusion   # nom du pod StreamFusion (si SF_DB_BRIDGE=1)
