# Configuration de sffs. Copier en $SFFS_STACK/config/sffs.env, chmod 600 (contient des secrets).

# --- StreamFusion (obligatoire) ---------------------------------------------------------
# Base Postgres de StreamFusion, en LECTURE SEULE (l'option ci-dessous l'impose côté session).
#  - via le pont (SF_DB_BRIDGE=1) : host=<SFFS_STACK>/run/sfpg (socket Unix)
#  - sinon : postgres://user:pass@host:5432/streamfusion?...
SF_PG_DSN="postgres://streamfusion:CHANGEME@/streamfusion?host=/home/USER/sffs-stack/run/sfpg&sslmode=disable&options=-c%20default_transaction_read_only%3Don"

# URL de StreamFusion vue depuis CE serveur (sffs y résout les liens de lecture côté serveur).
SF_BASE=http://127.0.0.1:8080

# Config Stremio chiffrée (gAAAA…) : le segment avant /manifest.json de l'URL d'installation
# de l'addon. Sert à savoir quelles sources sont en cache chez AllDebrid.
# deploy/bin/sf-config.sh <url-du-manifest> affiche SF_STREAM_CFG et SF_PLAYBACK_CFG.
SF_STREAM_CFG=gAAAAA_CHANGEME
# 1er segment (base64) après /playback/ dans les URL de flux renvoyées par StreamFusion.
# Contient le token AllDebrid : à garder secret.
SF_PLAYBACK_CFG=CHANGEME

# --- Montage ---------------------------------------------------------------------------
SFFS_MOUNT=/home/USER/sffs-stack/mnt
# Seuls ces programmes peuvent lire les fichiers (les autres ne déclenchent aucun téléchargement).
SFFS_ALLOW_COMM='^(silo|ffmpeg|ffprobe)$'
# Durée pendant laquelle un fichier « armé » par Silo reste lisible.
SFFS_ARM_TTL=6h
GOMAXPROCS=4

# --- Sélection des versions -------------------------------------------------------------
SFFS_LANGS=fr                 # langues préférées, dans l'ordre (ex. fr,en)
SFFS_REQUIRE_PREFERRED_HD=1   # 1 = ignorer les titres sans version dans une langue préférée
SFFS_PER_QUALITY=5            # versions gardées par qualité (2160/1080/720) pour un film
SFFS_TMDB=                    # vide = tous les films ; sinon liste d'IDs TMDB (tests)

# --- Séries ----------------------------------------------------------------------------
SFFS_SERIES=1
SFFS_SERIES_PER_QUALITY=2     # versions par qualité et par épisode
SFFS_SERIES_TMDB=             # vide = toutes les séries
SFFS_TMDB_KEY=CHANGEME        # clé API TMDB (v3) : liste des épisodes par saison
SFFS_DEBRID_PROXY=             # proxy des téléchargements AllDebrid (ex. socks5://warp:1080) ; vide = direct
SFFS_TMDB_CACHE=/home/USER/sffs-stack/run/tmdb-tv.json
# Sources déjà vues en cache (placées en tête de la sélection).
SFFS_KNOWN_CACHE=/home/USER/sffs-stack/run/known-cached.json

# --- Mises à jour automatiques -----------------------------------------------------------
SFFS_WATCH=1m                 # détection des nouveautés StreamFusion (0 = désactivé)
SFFS_RELOAD=24h               # rechargement complet de sécurité (0 = jamais)
# Scans Silo ciblés sur les dossiers modifiés (laisser vide pour désactiver).
SFFS_SILO_URL=http://127.0.0.1:27461
SFFS_SILO_KEY=                # clé d'API admin Silo : deploy/bin/make-silo-key.sh
# Chemins des dossiers tels que Silo les voit (montage dans le conteneur).
SFFS_SILO_FILMS=/mnt/sf/films
SFFS_SILO_SERIES=/mnt/sf/series
