# Variables du conteneur Silo. Copier en $SFFS_STACK/config/silo.env, chmod 600.
MODE=integrated
PORT=8080
JF_PORT=8096
ABS_PORT=13378
# openssl rand -hex 32
SECRET_KEY=CHANGEME
# Même mot de passe que POSTGRES_PASSWORD dans pg.env.
DATABASE_URL=postgres://silo:CHANGEME@127.0.0.1:5432/silo?sslmode=disable
REDIS_URL=redis://127.0.0.1:6379
SILO_PLUGIN_CACHE_DIR=/var/lib/silo/plugins
POSTGRES_TUNE=off
SILO_SHUTDOWN_DELAY=0
# Limite les threads Go (utile sur un hôte avec beaucoup de CPU et un plafond de processus).
GOMAXPROCS=4
