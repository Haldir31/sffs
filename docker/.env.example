# Docker Compose : copier en docker/.env, chmod 600.

# --- Silo ------------------------------------------------------------------------------
# openssl rand -hex 32
SILO_SECRET_KEY=CHANGEME
# openssl rand -hex 24
SILO_DB_PASS=CHANGEME
SILO_WEB_PORT=27461
SILO_JF_PORT=21481
SILO_GOMAXPROCS=8
TZ=Europe/Paris

# --- Montage sur l'hôte ------------------------------------------------------------------
SFFS_HOST_MOUNT=/mnt/sffs

# --- StreamFusion --------------------------------------------------------------------------
# Réseau Docker de StreamFusion (docker network ls). SSDV2 : traefik_proxy.
SF_NETWORK=streamfusion
# Base de StreamFusion : rôle en LECTURE SEULE conseillé (voir README, étape 3).
SF_PG_DSN=postgres://sffs_reader:CHANGEME@stremio-postgres:5432/streamfusion?sslmode=disable&options=-c%20default_transaction_read_only%3Don
SF_BASE=http://stream-fusion:8080
# deploy/bin/sf-config.sh '<url du manifest de l'addon>'
SF_STREAM_CFG=gAAAAA_CHANGEME
SF_PLAYBACK_CFG=CHANGEME

# --- Sélection et séries -------------------------------------------------------------------
SFFS_LANGS=fr
SFFS_REQUIRE_PREFERRED_HD=1
SFFS_PER_QUALITY=5
SFFS_SERIES=1
SFFS_SERIES_PER_QUALITY=2
SFFS_TMDB_KEY=CHANGEME
SFFS_WATCH=1m
SFFS_RELOAD=24h
GOMAXPROCS=4

# --- Scans ciblés (après création du compte admin) : docker/silo-key.sh -------------------------
SFFS_SILO_KEY=
