index 000000000..bd48a34e8
--- /dev/null
+++ b/internal/playback/sf_not_cached.go
@@ -0,0 +1,10 @@
+package playback
+
+// TerminalSourceNotCachedV3 remplace source_unreadable pour une version virtuelle sffs : sffs la
+// déclare illisible pour la lecture quand elle n'est pas prête chez le débrideur. Le fichier n'est
+// pas abîmé ; il peut être lu plus tard, dès qu'une version est en cache.
+const TerminalSourceNotCachedV3 = "source_not_cached"
+
+// TerminalSourceNotCachedMessageV3 est le message affiché par les clients qui ne connaissent pas
+// le code (application web, applications natives : repli sur terminal.message).
+const TerminalSourceNotCachedMessageV3 = "Aucune version de ce titre n'est disponible chez AllDebrid pour le moment. Réessayez plus tard ou choisissez un autre titre."
diff --git a/internal/playback/sf_not_cached_test.go b/internal/playback/sf_not_cached_test.go
