--- /dev/null
+++ b/internal/playback/sf_not_cached_test.go
@@ -0,0 +1,35 @@
+package playback
+
+import (
+	"testing"
+	"time"
+
+	"github.com/Silo-Server/silo-server/internal/models"
+)
+
+// Une version sffs rejetée (hors cache chez le débrideur) n'est pas annoncée comme abîmée.
+func TestPlanPlaybackV3SffsRejectedIsNotCached(t *testing.T) {
+	t.Setenv("SILO_SF_ROOT", "/mnt/sffs")
+	req := validStartRequestV3()
+	settings := PlannerSettingsV3{TranscodeEnabled: true, Allow4KTranscode: true}
+	failedAt := time.Date(2026, time.October, 28, 12, 6, 46, 0, time.UTC)
+	rejected := func(path string) *models.MediaFile {
+		return &models.MediaFile{ID: 9, FilePath: path, ProbeFailedAt: &failedAt, SubtitleTracks: []models.SubtitleTrack{}}
+	}
+
+	sf := rejected("/mnt/sffs/films/Titre (2023) {tmdb-1}/Titre.mkv")
+	result := PlanPlaybackV3(PlannerInputV3{Request: req, RequestedFile: sf, EffectiveFile: sf, AudioTrackIndex: 0, Settings: settings, Registry: testTransformationRegistryV3()})
+	if result.Terminal == nil || result.Terminal.Reason != TerminalSourceNotCachedV3 || result.Terminal.Retryable {
+		t.Fatalf("sffs result = %s", ExplainPlannerResultV3(result))
+	}
+	if result.Terminal.Message != TerminalSourceNotCachedMessageV3 {
+		t.Fatalf("message = %q", result.Terminal.Message)
+	}
+
+	// Un fichier ordinaire rejeté reste source_unreadable.
+	plain := rejected("/library/films/Titre.mkv")
+	result = PlanPlaybackV3(PlannerInputV3{Request: req, RequestedFile: plain, EffectiveFile: plain, AudioTrackIndex: 0, Settings: settings, Registry: testTransformationRegistryV3()})
+	if result.Terminal == nil || result.Terminal.Reason != TerminalSourceUnreadableV3 {
+		t.Fatalf("plain result = %s", ExplainPlannerResultV3(result))
+	}
+}
