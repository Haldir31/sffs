Sans durée connue (elle vient à la première lecture), un fichier sffs était marqué
probe_repair à chaque scan et sa ligne réécrite, alors qu'il ne peut pas être analysé
au scan. Le scan nocturne retraitait ainsi les 6,4 millions de versions.
---
 internal/scanner/scanner.go                | 13 +++++++--
 internal/scanner/sffs_probe_repair_test.go | 33 ++++++++++++++++++++++
 2 files changed, 44 insertions(+), 2 deletions(-)
 create mode 100644 internal/scanner/sffs_probe_repair_test.go

diff --git a/internal/scanner/scanner.go b/internal/scanner/scanner.go
index 2f9743412..b906e8742 100644
--- a/internal/scanner/scanner.go
+++ b/internal/scanner/scanner.go
@@ -3095,8 +3095,11 @@ func (s *Scanner) processFile(
 	// without forcing endless rewrites on nodes that cannot probe.
 	if existing, ok := existingByPath[filePath]; ok {
 		currentExternalSubtitlePaths := externalSubtitleInfoPaths(loadExternalSubs())
-		updateReasons := scanStateUpdateReasons(existing, fileSize, fileModifiedAt, currentExternalSubtitlePaths, externalSubsChecked, assignment, groupAssignment, folder.Type, s.ffprobePath != "")
-		if shouldSkipStableConfirmedScanState(existing, existingContentStatuses[existing.ContentID], fileSize, fileModifiedAt, updateReasons, s.ffprobePath != "") {
+		// sffs : un fichier virtuel n'est jamais analysé au scan (sa durée vient à la première
+		// lecture) ; sans cela, l'absence de durée le ferait réécrire à chaque scan.
+		canRepairProbe := s.canRepairProbeAtScan(filePath)
+		updateReasons := scanStateUpdateReasons(existing, fileSize, fileModifiedAt, currentExternalSubtitlePaths, externalSubsChecked, assignment, groupAssignment, folder.Type, canRepairProbe)
+		if shouldSkipStableConfirmedScanState(existing, existingContentStatuses[existing.ContentID], fileSize, fileModifiedAt, updateReasons, canRepairProbe) {
 			return actionUnchanged, nil, nil
 		}
 		if len(updateReasons) == 0 {
@@ -4280,6 +4283,12 @@ func (s *Scanner) clearLegacyLinksForUnmatchableRoots(_ context.Context, _ int,
 	return 0, nil
 }
 
+// canRepairProbeAtScan indique si un scan peut analyser ce fichier pour compléter ses infos
+// techniques. Jamais pour un fichier virtuel sffs : il serait lu chez le débrideur.
+func (s *Scanner) canRepairProbeAtScan(filePath string) bool {
+	return s.ffprobePath != "" && !sfvirtual.Under(filePath)
+}
+
 // gatherHints computes the OSHash for a media file.
 func (s *Scanner) gatherHints(filePath string) FileHints {
 	hints := FileHints{}
diff --git a/internal/scanner/sffs_probe_repair_test.go b/internal/scanner/sffs_probe_repair_test.go
new file mode 100644
index 000000000..06c8bd93e
--- /dev/null
+++ b/internal/scanner/sffs_probe_repair_test.go
@@ -0,0 +1,33 @@
+package scanner
+
+import (
+	"slices"
+	"testing"
+	"time"
+)
+
+// Un fichier sffs inchangé sans durée ne doit pas être réécrit à chaque scan.
+func TestSffsVirtualFileNotRewrittenForProbeRepair(t *testing.T) {
+	t.Setenv("SILO_SF_ROOT", "/mnt/sf")
+	s := &Scanner{ffprobePath: "/usr/bin/ffprobe"}
+	mt := time.Unix(1792866265, 0).UTC()
+	existing := &scanStateFile{FileSize: 1000, FileModifiedAt: &mt} // durée 0, jamais analysé
+
+	virtual := "/mnt/sf/series/X (2020) {tmdb-1}/Season 01/X - S01E01 - a.mkv"
+	if s.canRepairProbeAtScan(virtual) {
+		t.Fatal("un fichier sffs ne doit jamais être analysé au scan")
+	}
+	reasons := scanStateUpdateReasons(existing, 1000, mt, nil, true, fileRootAssignment{}, fileGroupAssignment{}, "series", s.canRepairProbeAtScan(virtual))
+	if slices.Contains(reasons, "probe_repair") {
+		t.Fatalf("fichier sffs inchangé : motifs %v, probe_repair inattendu", reasons)
+	}
+
+	local := "/mnt/media/tv/X/Season 01/X.S01E01.mkv"
+	if !s.canRepairProbeAtScan(local) {
+		t.Fatal("un fichier ordinaire reste réparable au scan")
+	}
+	reasons = scanStateUpdateReasons(existing, 1000, mt, nil, true, fileRootAssignment{}, fileGroupAssignment{}, "series", s.canRepairProbeAtScan(local))
+	if !slices.Contains(reasons, "probe_repair") {
+		t.Fatalf("fichier ordinaire sans durée : probe_repair attendu, motifs %v", reasons)
+	}
+}
