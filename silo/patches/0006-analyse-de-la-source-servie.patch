Subject: [PATCH 6/6] =?UTF-8?q?sffs=20:=20analyser=20la=20source=20r=C3=A9?=
 =?UTF-8?q?ellement=20servie=20(rempla=C3=A7ante=20comprise)?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

sffs peut remplacer une version hors cache par une autre (autre codec, autres pistes, autre
taille). Au lancement d'une lecture, si probe_source ne vaut pas sf:<hash servi>, ffprobe
analyse la source servie et la ligne media_files est réécrite (pistes, codecs, taille réelle).
Après un échec de ffprobe sur une source, pas de nouvel essai pendant une heure : un
lecteur redemande la lecture en boucle, et chaque essai lit le début du fichier chez le débrideur.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01AbUx511UGbcCoLk6U5BQjP
---
 internal/scanner/probe_repair.go | 91 ++++++++++++++++++++++++++++++++
 internal/sfvirtual/sfvirtual.go  | 27 ++++++++++
 2 files changed, 118 insertions(+)

diff --git a/internal/scanner/probe_repair.go b/internal/scanner/probe_repair.go
index 8690f55d2..c8d05233d 100644
--- a/internal/scanner/probe_repair.go
+++ b/internal/scanner/probe_repair.go
@@ -3,6 +3,7 @@ package scanner
 import (
 	"context"
 	"errors"
+	"fmt"
 	"log/slog"
 	"strconv"
 	"strings"
@@ -10,6 +11,7 @@ import (
 	"sync/atomic"
 	"time"
 
+	"github.com/Silo-Server/silo-server/internal/fspath"
 	"github.com/Silo-Server/silo-server/internal/mediaprobe"
 	"github.com/Silo-Server/silo-server/internal/models"
 	"github.com/Silo-Server/silo-server/internal/sfvirtual"
@@ -422,6 +424,16 @@ func (e *PlaybackProbeEnsurer) ensureProbeRepair(ctx context.Context, file *mode
 	// One snapshot per repair: the guard and the ffprobe run must see the same
 	// binaries, or a SetFFmpegPath between them hands probeFile an empty path.
 	ffprobePath := strings.TrimSpace(e.binaries().ffprobePath)
+	// Version virtuelle armée et en cache : la probe doit décrire la source que sffs sert
+	// réellement (une remplaçante peut avoir un autre codec, d'autres pistes, une autre taille).
+	if sfvirtual.Under(file.FilePath) && ffprobePath != "" {
+		if marker := sfvirtual.ServedMarker(file.FilePath); marker != "" {
+			if file.ProbeSource != marker {
+				return e.ensureSFServedProbe(ctx, file, ffprobePath, marker)
+			}
+			return file, nil
+		}
+	}
 	if NeedsCriticalProbeRepair(file) && ffprobePath != "" {
 		repaired, err := e.ensureCriticalProbe(ctx, file, ffprobePath)
 		if err != nil {
@@ -510,6 +522,85 @@ func (e *PlaybackProbeEnsurer) ensureCriticalProbe(ctx context.Context, file *mo
 	}
 }
 
+// ensureSFServedProbe analyse avec ffprobe la source que sffs sert réellement pour une version
+// virtuelle (armée, en cache) et enregistre le résultat avec probe_source = marker, ainsi que la
+// taille réelle du fichier. Une seule analyse à la fois par fichier et par source.
+func (e *PlaybackProbeEnsurer) ensureSFServedProbe(ctx context.Context, file *models.MediaFile, ffprobePath, marker string) (*models.MediaFile, error) {
+	sharedCtx := context.WithoutCancel(ctx)
+	key := fmt.Sprintf("sfserved:%d:%s", file.ID, marker)
+	// Échec récent sur cette source : pas de nouvel essai avant sfServedRetryAfter. Chaque essai lit
+	// le début du fichier chez le débrideur, et un lecteur redemande la lecture en boucle.
+	if until, ok := sfServedFailures.Load(key); ok && time.Now().Before(until.(time.Time)) {
+		return file, errSFServedProbeBackoff
+	}
+	resultCh := e.probeRepair.DoChan(key, func() (any, error) {
+		lookupCtx, cancelLookup := context.WithTimeout(sharedCtx, 10*time.Second)
+		current, err := e.fileRepo.GetByID(lookupCtx, file.ID)
+		cancelLookup()
+		if err != nil {
+			return nil, err
+		}
+		if current == nil || current.ProbeSource == marker {
+			return current, nil
+		}
+		// Lecture distante (débrideur) : plus lente qu'un disque local.
+		probeCtx, cancel := context.WithTimeout(sharedCtx, 90*time.Second)
+		defer cancel()
+		if e.probeSlots != nil {
+			select {
+			case e.probeSlots <- struct{}{}:
+				defer func() { <-e.probeSlots }()
+			case <-probeCtx.Done():
+				return nil, probeCtx.Err()
+			}
+		}
+		probeFile := e.probeFile
+		if probeFile == nil {
+			probeFile = probeFileStreamsOnly
+		}
+		t0 := time.Now()
+		probe, err := probeFile(probeCtx, ffprobePath, current.FilePath)
+		if err != nil || probe == nil {
+			sfServedFailures.Store(key, time.Now().Add(sfServedRetryAfter))
+			slog.WarnContext(sharedCtx, "streamfusion: probe de la source servie impossible", "component", "scanner", "file_id", current.ID, "source", marker, "error", err, "retry_after", sfServedRetryAfter)
+			if err == nil {
+				err = fmt.Errorf("streamfusion: probe vide")
+			}
+			return nil, err
+		}
+		updated := *current
+		applyProbeData(&updated, probe, marker)
+		if st, statErr := fspath.Stat(current.FilePath); statErr == nil && st.Size() > 0 {
+			updated.FileSize = st.Size()
+		}
+		slog.InfoContext(sharedCtx, "streamfusion: probe de la source servie", "component", "scanner",
+			"file_id", current.ID, "source", marker, "previous_source", current.ProbeSource,
+			"codec_video", updated.CodecVideo, "codec_audio", updated.CodecAudio,
+			"previous_codec_video", current.CodecVideo, "size", updated.FileSize, "took_ms", time.Since(t0).Milliseconds())
+		return e.fileRepo.Upsert(probeCtx, updated)
+	})
+	select {
+	case <-ctx.Done():
+		return file, ctx.Err()
+	case result := <-resultCh:
+		if result.Err != nil {
+			return file, result.Err
+		}
+		repaired, _ := result.Val.(*models.MediaFile)
+		if repaired == nil {
+			return file, nil
+		}
+		return repaired, nil
+	}
+}
+
+// sfServedFailures : échecs récents de ensureSFServedProbe (clé fichier + source -> fin d'attente).
+var sfServedFailures sync.Map
+
+const sfServedRetryAfter = time.Hour
+
+var errSFServedProbeBackoff = errors.New("streamfusion: analyse de cette source en échec récemment, nouvel essai plus tard")
+
 // recordProbeRejection persists that ffprobe refused the file and returns the
 // row as stored afterwards, so the planner can answer with a terminal that
 // names the damaged file instead of one that suggests waiting for a scan. It
diff --git a/internal/sfvirtual/sfvirtual.go b/internal/sfvirtual/sfvirtual.go
index bdfd0a245..835fcc894 100644
--- a/internal/sfvirtual/sfvirtual.go
+++ b/internal/sfvirtual/sfvirtual.go
@@ -21,8 +21,14 @@ const (
 	attrArm    = "user.sf.arm"
 	attrArmed  = "user.sf.armed"
 	attrCached = "user.sf.cached"
+	attrServed = "user.sf.served"
 )
 
+// ServedMarkerPrefix préfixe media_files.probe_source quand la probe décrit la source que sffs
+// sert réellement : "sf:<hash>". sffs peut remplacer une version absente du cache par une autre
+// (autre codec, autres pistes, autre taille) : une probe faite sur une autre source est périmée.
+const ServedMarkerPrefix = "sf:"
+
 // Info décrit une version telle que sffs la tire de la base StreamFusion.
 type Info struct {
 	Container   string   `json:"container"`
@@ -121,3 +127,24 @@ func Arm(path string) {
 	}
 	_, _ = getxattr(path, attrArm)
 }
+
+// Served renvoie le hash de la source que sffs sert réellement pour path (la remplaçante s'il y en
+// a une), ou "" si la version est hors cache, si path n'est pas virtuel ou si sffs est trop ancien.
+func Served(path string) string {
+	if !Under(path) {
+		return ""
+	}
+	b, err := getxattr(path, attrServed)
+	if err != nil {
+		return ""
+	}
+	return strings.TrimSpace(string(b))
+}
+
+// ServedMarker renvoie la valeur de probe_source d'une probe faite sur la source servie.
+func ServedMarker(path string) string {
+	if h := Served(path); h != "" {
+		return ServedMarkerPrefix + h
+	}
+	return ""
+}
