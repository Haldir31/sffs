diff --git a/internal/scanner/sf_virtual.go b/internal/scanner/sf_virtual.go
new file mode 100644
index 000000000..0e6cec988
--- /dev/null
+++ b/internal/scanner/sf_virtual.go
@@ -0,0 +1,79 @@
+package scanner
+
+import (
+	"strings"
+
+	"github.com/Silo-Server/silo-server/internal/lang"
+	"github.com/Silo-Server/silo-server/internal/sfvirtual"
+)
+
+// probeSourceSF est le media_files.probe_source d'une version virtuelle StreamFusion :
+// ses caractéristiques viennent du nom de release, pas de ffprobe.
+const probeSourceSF = "streamfusion"
+
+// sfProbeData convertit les caractéristiques sffs en données de probe Silo.
+func sfProbeData(info *sfvirtual.Info) *ProbeData {
+	p := &ProbeData{
+		CodecVideo:    info.CodecVideo,
+		CodecAudio:    info.CodecAudio,
+		Resolution:    info.Resolution,
+		AudioChannels: info.Channels,
+		HDR:           info.HDR,
+		Container:     info.Container,
+		FormatTags:    map[string]string{"title": info.Release},
+	}
+	if p.Container == "mkv" {
+		p.Container = "matroska"
+	}
+	vt := VideoTrackInfo{
+		Codec:    info.CodecVideo,
+		Width:    info.Width,
+		Height:   info.Height,
+		BitDepth: info.BitDepth,
+	}
+	switch {
+	case info.DolbyVision:
+		// Profil inconnu : on suppose le cas courant (profil 8, repli HDR10).
+		vt.DVProfile, vt.DVBLCompatID, vt.DVBLCompatIDPresent, vt.DVConfigPresent = 8, 1, true, true
+		vt.DolbyVision = "Profile 8"
+		vt.VideoRange, vt.VideoRangeType = "DolbyVision", "DOVIWithHDR10"
+		if info.HDR10Plus {
+			vt.VideoRangeType = "DOVIWithHDR10Plus"
+		}
+		vt.ColorTransfer, vt.ColorPrimaries, vt.ColorSpace = "smpte2084", "bt2020", "bt2020nc"
+	case info.HDR:
+		vt.VideoRange, vt.VideoRangeType = "HDR", "HDR10"
+		if info.HDR10Plus {
+			vt.VideoRangeType, vt.HDR10Plus = "HDR10Plus", true
+		}
+		vt.ColorTransfer, vt.ColorPrimaries, vt.ColorSpace = "smpte2084", "bt2020", "bt2020nc"
+	default:
+		vt.VideoRangeType = "SDR"
+	}
+	if vt.BitDepth == 0 && (info.HDR || info.DolbyVision) {
+		vt.BitDepth = 10
+	}
+	if info.CodecVideo != "" {
+		p.VideoTracks = []VideoTrackInfo{vt}
+	}
+
+	// Une piste audio par langue annoncée ("multi" seul = langue inconnue).
+	langs := []string{}
+	for _, l := range info.Languages {
+		if l = strings.ToLower(strings.TrimSpace(l)); l != "" && l != "multi" && l != "vo" {
+			langs = append(langs, l)
+		}
+	}
+	if len(langs) == 0 {
+		langs = []string{""}
+	}
+	for i, l := range langs {
+		p.AudioTracks = append(p.AudioTracks, AudioTrackInfo{
+			Language: lang.CompatibleTag(l),
+			Codec:    info.CodecAudio,
+			Channels: info.Channels,
+			Default:  i == 0,
+		})
+	}
+	return p
+}
diff --git a/internal/sfvirtual/sfvirtual.go b/internal/sfvirtual/sfvirtual.go
new file mode 100644
index 000000000..41f9eab5b
--- /dev/null
+++ b/internal/sfvirtual/sfvirtual.go
@@ -0,0 +1,102 @@
+// Package sfvirtual reconnaît les fichiers virtuels exposés par sffs (bibliothèque StreamFusion).
+//
+// sffs présente les torrents de StreamFusion comme des fichiers sous SILO_SF_ROOT (défaut
+// /mnt/sf). Leurs caractéristiques sont lues dans l'attribut étendu user.sf.probe au lieu de
+// ffprobe, et leurs octets ne sont accessibles qu'après Arm (user.sf.arm), appelé au lancement
+// d'une lecture : les lectures de fond (vignettes, analyses) n'atteignent jamais le débrideur.
+package sfvirtual
+
+import (
+	"encoding/json"
+	"errors"
+	"os"
+	"strings"
+	"syscall"
+
+	"github.com/Silo-Server/silo-server/internal/fspath"
+)
+
+const (
+	attrProbe = "user.sf.probe"
+	attrArm   = "user.sf.arm"
+)
+
+// Info décrit une version telle que sffs la tire de la base StreamFusion.
+type Info struct {
+	Container   string   `json:"container"`
+	Resolution  string   `json:"resolution"`
+	Width       int      `json:"width"`
+	Height      int      `json:"height"`
+	CodecVideo  string   `json:"codec_video"`
+	CodecAudio  string   `json:"codec_audio"`
+	Channels    int      `json:"channels"`
+	HDR         bool     `json:"hdr"`
+	DolbyVision bool     `json:"dolby_vision"`
+	HDR10Plus   bool     `json:"hdr10_plus"`
+	BitDepth    int      `json:"bit_depth"`
+	Languages   []string `json:"languages"`
+	Quality     string   `json:"quality"`
+	Release     string   `json:"release"`
+	InfoHash    string   `json:"info_hash"`
+	Indexer     string   `json:"indexer"`
+}
+
+func root() string {
+	if r := strings.TrimRight(os.Getenv("SILO_SF_ROOT"), "/"); r != "" {
+		return r
+	}
+	return "/mnt/sf"
+}
+
+// Under indique si path est sous la racine sffs (aucun appel système).
+func Under(path string) bool {
+	r := root()
+	return path == r || strings.HasPrefix(path, r+"/")
+}
+
+// getxattr lit un attribut étendu ; path est un chemin Silo (encodé, voir fspath).
+func getxattr(path, name string) ([]byte, error) {
+	path = fspath.Decode(path)
+	buf := make([]byte, 4096)
+	for {
+		n, err := syscall.Getxattr(path, name, buf)
+		if errors.Is(err, syscall.ERANGE) {
+			buf = make([]byte, len(buf)*4)
+			continue
+		}
+		if err != nil {
+			return nil, err
+		}
+		return buf[:n], nil
+	}
+}
+
+// Probe renvoie les caractéristiques d'un fichier virtuel, ou ok=false pour un fichier ordinaire.
+func Probe(path string) (*Info, bool) {
+	if !Under(path) {
+		return nil, false
+	}
+	b, err := getxattr(path, attrProbe)
+	if err != nil {
+		return nil, false
+	}
+	var info Info
+	if json.Unmarshal(b, &info) != nil {
+		return nil, false
+	}
+	return &info, true
+}
+
+// IsVirtual indique si path est un fichier virtuel sffs.
+func IsVirtual(path string) bool {
+	_, ok := Probe(path)
+	return ok
+}
+
+// Arm autorise la lecture de path pendant quelques heures. Sans effet sur un fichier ordinaire.
+func Arm(path string) {
+	if !Under(path) {
+		return
+	}
+	_, _ = getxattr(path, attrArm)
+}
