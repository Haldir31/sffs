Ces analyses lanceraient ffprobe/ffmpeg sur le fichier, donc chez le
debrideur ; leurs caracteristiques viennent de StreamFusion.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 internal/scanner/probe_repair.go | 11 ++++++++++-
 1 file changed, 10 insertions(+), 1 deletion(-)

diff --git a/internal/scanner/probe_repair.go b/internal/scanner/probe_repair.go
index 0ef1b64c4..83bea74bd 100644
--- a/internal/scanner/probe_repair.go
+++ b/internal/scanner/probe_repair.go
@@ -12,6 +12,7 @@ import (
 
 	"github.com/Silo-Server/silo-server/internal/mediaprobe"
 	"github.com/Silo-Server/silo-server/internal/models"
+	"github.com/Silo-Server/silo-server/internal/sfvirtual"
 	"github.com/Silo-Server/silo-server/internal/tonemap"
 	"golang.org/x/sync/singleflight"
 )
@@ -327,6 +328,9 @@ func (e *PlaybackProbeEnsurer) NeedsCopySafetyScan(file *models.MediaFile) bool
 	if e == nil || strings.TrimSpace(e.binaries().ffmpegPath) == "" || !needsCopySafetyProbe(file) {
 		return false
 	}
+	if file != nil && sfvirtual.Under(file.FilePath) {
+		return false
+	}
 	_, known := e.knownCopySafetyVerdict(file)
 	return !known
 }
@@ -399,6 +403,11 @@ func (e *PlaybackProbeEnsurer) ensureProbeRepair(ctx context.Context, file *mode
 	if file == nil || e == nil || e.fileRepo == nil {
 		return file, nil
 	}
+	// Version virtuelle StreamFusion : ses caractéristiques viennent de StreamFusion, et un
+	// ffprobe lirait le fichier chez le débrideur.
+	if sfvirtual.Under(file.FilePath) {
+		return file, nil
+	}
 
 	current := file
 	// One snapshot per repair: the guard and the ffprobe run must see the same
@@ -544,7 +553,7 @@ func (e *PlaybackProbeEnsurer) recordProbeRejection(ctx context.Context, current
 // longer re-reads the opening seconds of every browsed H.264 file.
 func (e *PlaybackProbeEnsurer) ensureCopySafety(ctx context.Context, file *models.MediaFile) (*models.MediaFile, error) {
 	ffmpegPath := strings.TrimSpace(e.binaries().ffmpegPath)
-	if !needsCopySafetyProbe(file) || ffmpegPath == "" {
+	if !needsCopySafetyProbe(file) || ffmpegPath == "" || sfvirtual.Under(file.FilePath) {
 		return file, nil
 	}
 
